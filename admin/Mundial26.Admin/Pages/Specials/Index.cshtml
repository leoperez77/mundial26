@page
@model Mundial26.Admin.Pages.Specials.IndexModel
@{
    ViewData["Title"] = "Specials";
}

<h1>Specials</h1>
<p class="text-muted">Intro, FWC, host countries, history, and extra purple stickers.</p>

@if (TempData["Saved"] is not null)
{
    <div class="alert alert-success">Saved.</div>
}

<form method="post">
    @foreach (var (key, title) in Mundial26.Admin.Pages.Specials.IndexModel.Sections)
    {
        var rows = Model.ItemsFor(key).ToList();
        if (rows.Count == 0) { continue; }
        <h2 class="h5 mt-4">@title</h2>
        <table class="table table-sm align-middle">
            <thead>
                <tr>
                    <th style="width: 10rem;">Code</th>
                    <th>Name</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in rows)
                {
                    var i = Model.IndexOf(item);
                    <tr>
                        <td>
                            <input type="hidden" asp-for="Items[i].Id" />
                            <input type="hidden" asp-for="Items[i].Section" />
                            @if (key == "extra_stickers_purple")
                            {
                                <input type="hidden" asp-for="Items[i].Code" />
                                <span class="text-muted">—</span>
                            }
                            else
                            {
                                <input asp-for="Items[i].Code" class="form-control form-control-sm" />
                            }
                        </td>
                        <td>
                            <input asp-for="Items[i].Name" class="form-control form-control-sm" />
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <button type="submit" class="btn btn-primary mt-3">Save</button>
</form>
